# Copy to .env and fill in values before deploying.
# Set these as Firebase function config:
#   firebase functions:config:set vapi.api_key="..." vapi.phone_number_id="..."

VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_WEBHOOK_SECRET=optional_webhook_signing_secret
VAPI_DEMO_OWNER_PHONE=+15550000000
CALENDLY_DEFAULT_URL=https://calendly.com/your-name/inspection
